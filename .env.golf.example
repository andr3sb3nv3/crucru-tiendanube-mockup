GOLF_EMAIL=tu-email@example.com
GOLF_PASSWORD=tu-password
GOLF_CLUB="Lagos de Palermo"
GOLF_BOOKING_TEXT="practica deportiva feriado"
GOLF_PLAYERS=4

# Por seguridad el agente no confirma reservas salvo que esto sea true.
GOLF_CONFIRM_BOOKING=false

# Opcionales
GOLF_URL=https://www.golf-tracker.com/main
GOLF_HEADLESS=false
GOLF_DATE_OFFSET_DAYS=4
GOLF_ADVANCE_DAYS=4
GOLF_ALLOWED_TARGET_DAYS=0,1,2,3,4,5,6
GOLF_ENFORCE_ALLOWED_DAYS=false
GOLF_TIME_WINDOW_START=12:30
GOLF_TIME_WINDOW_END=14:30
GOLF_POLL_SECONDS=15
GOLF_MAX_ATTEMPTS=1
GOLF_OUTPUT_DIR=outputs/golf-agent
